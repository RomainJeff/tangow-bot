{
  "name": "@tangow/db",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sessions.test-support": {
      "types": "./src/sessions.test-support.ts",
      "default": "./src/sessions.test-support.ts"
    },
    "./pglite.test-support": {
      "types": "./src/pglite.test-support.ts",
      "default": "./src/pglite.test-support.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/db/src"
  },
  "dependencies": {
    "@tangow/adapter-kit": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tangow/contracts": "workspace:*",
    "@tangow/core": "workspace:*",
    "@tangow/logging": "workspace:*",
    "pg": "8.23.0",
    "dotenv": "17.4.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
